<%- include('../layouts/main', { body: `
<div class="space-y-6">
  <a href="${esc(back)}" class="inline-flex items-center gap-2 text-surface-400 hover:text-surface-200 transition-colors">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    Back to Website Visitors
  </a>

  <!-- Person -->
  <div class="card">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="eyebrow">Website Visitor</p>
        <div class="flex items-center gap-3 mt-2">
          <h1 class="page-title">${esc(person.name)}</h1>
          <span class="badge ${person.tier === 'hot' ? 'badge-hot' : person.tier === 'warm' ? 'badge-info' : 'badge-default'}">${person.score} &middot; <span class="capitalize ml-1">${person.tier}</span></span>
        </div>
        ${person.jobTitle || person.company ? `<p class="text-surface-400 mt-1">${esc([person.jobTitle, person.company].filter(Boolean).join(' at '))}</p>` : ''}
      </div>
      <div class="flex gap-6 text-sm">
        <div><p class="stat-label mb-1">Visits</p><p class="text-surface-100 font-semibold text-lg">${person.visits}</p></div>
        <div><p class="stat-label mb-1">First seen</p><p class="text-surface-100">${esc(person.firstSeen)}</p></div>
        <div><p class="stat-label mb-1">Last seen</p><p class="text-surface-100">${esc(person.lastSeen)}</p></div>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6 text-sm">
      <div><p class="stat-label mb-1">Email</p>${person.email ? `<p class="text-surface-100 select-all break-all">${esc(person.email)}</p>` : '<p class="text-surface-600">&mdash;</p>'}</div>
      <div><p class="stat-label mb-1">Phone</p>${person.phone ? `<p class="text-surface-100 tabular-nums select-all">${esc(person.phoneDisplay)}</p>` : '<p class="text-surface-600">&mdash;</p>'}</div>
      <div><p class="stat-label mb-1">Address</p><p class="text-surface-200">${esc(person.address) || '&mdash;'}</p></div>
      <div><p class="stat-label mb-1">LinkedIn</p>${/^https?:/i.test(person.linkedin) ? `<a href="${esc(person.linkedin)}" target="_blank" rel="noopener noreferrer" class="text-brand-400 hover:underline break-all">${esc(person.linkedin)}</a>` : `<p class="text-surface-200">${esc(person.linkedin) || '&mdash;'}</p>`}</div>
    </div>
  </div>

  <!-- Pages visited -->
  <div class="card">
    <h2 class="text-lg font-semibold text-surface-100 mb-4">Pages visited (${pages.length})</h2>
    ${pages.length === 0 ? `
    <p class="text-surface-400 text-sm">No page data for this visitor.</p>
    ` : `
    <div class="table-container">
      <table class="table">
        <thead><tr><th>When</th><th>Page</th></tr></thead>
        <tbody>
          ${pages.map(p => `
          <tr>
            <td class="whitespace-nowrap text-surface-300">${esc(p.at)}</td>
            <td class="break-all">
              <a href="${esc(p.url)}" target="_blank" rel="noopener noreferrer" class="text-brand-400 hover:underline">${esc(p.url)}</a>
              ${p.title ? `<div class="text-xs text-surface-500">${esc(p.title)}</div>` : ''}
            </td>
          </tr>`).join('')}
        </tbody>
      </table>
    </div>
    `}
  </div>

  <!-- Everything AudienceLab sent -->
  <div class="card">
    <h2 class="text-lg font-semibold text-surface-100 mb-4">All details (${fields.length})</h2>
    ${fields.length === 0 ? '<p class="text-surface-400 text-sm">No extra details.</p>' : `
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 text-sm">
      ${fields.map(f => `
      <div class="border-b border-surface-800 pb-2">
        <dt class="text-surface-500 capitalize">${esc(f.key)}</dt>
        <dd class="text-surface-200 break-words">${esc(f.val)}</dd>
      </div>`).join('')}
    </dl>`}
  </div>
</div>
` }) %>
